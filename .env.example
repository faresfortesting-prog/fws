# ── StudyStrike environment configuration ──
# Copy to ".env" and fill in real values. NEVER commit the real .env file.

# Server
PORT=4000
NODE_ENV=development

# Auth — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# SQLite database file location (relative to project root)
DATABASE_FILE=data/studystrike.db

# Demo accounts (seed). Set to "false" in production to disable seeding demo creds.
SEED_DEMO_DATA=true

# AI screen-content verification (server-side proxy ONLY — never expose in frontend JS)
# If unset, verification falls back to a privacy-safe "assumed compliant" result.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
